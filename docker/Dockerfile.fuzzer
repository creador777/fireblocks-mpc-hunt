# syntax=docker/dockerfile:1.7
FROM ubuntu:20.04@sha256:c664f8f86ed5a386b0a340d981b8f81714e21a8b9c73f658c4bea56aa179d54a AS builder

ARG DEBIAN_FRONTEND=noninteractive
# Reintentos acotados con backoff. Una ola de 15 shards perdio 6 porque los
# mirrors de Ubuntu rechazaron la conexion durante un par de minutos: cada
# shard reconstruye la imagen, asi que un mirror caido borra capacidad
# proporcional al tamaño de la ola.
#
# Los reintentos NO ocultan un fallo permanente: son cuatro intentos con
# timeout propio y espera creciente, y si el ultimo falla el RUN sale distinto
# de cero con el codigo real. Un paquete inexistente o un repositorio mal
# configurado fallan igual de rapido que antes, solo que cuatro veces.
#
# La solucion definitiva es no reconstruir por shard: ver
# .github/workflows/build-base-image.yml y docker/BASE_IMAGE.lock.
#
# Se reintenta el CICLO update+install, no cada comando por separado:
# `apt-get update` devuelve 0 aunque no haya podido bajar un solo indice --
# solo imprime "Some index files failed to download" -- asi que reintentarlo
# aislado no arregla nada. Quien falla de verdad es el install, y para que su
# reintento sirva hay que refrescar los indices antes.
RUN set -eu; \
    packages="build-essential ca-certificates clang cmake git libssl-dev uuid-dev"; \
    attempt=1; \
    while :; do \
      if timeout 300 apt-get update -o Acquire::Retries=3 \
         && timeout 600 apt-get install -y --no-install-recommends \
              -o Acquire::Retries=3 ${packages}; then \
        break; \
      fi; \
      status=$?; \
      if [ "${attempt}" -ge 4 ]; then \
        echo "BUILD_NETWORK_FAILURE stage=apt attempts=${attempt} status=${status}" >&2; \
        exit "${status}"; \
      fi; \
      echo "apt cycle ${attempt} failed with ${status}, retrying" >&2; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $(( attempt * 5 )); \
      attempt=$(( attempt + 1 )); \
    done; \
    rm -rf /var/lib/apt/lists/*

COPY --from=upstream . /src/upstream
COPY . /src/hunt

RUN cmake -S /src/hunt -B /build \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_C_COMPILER=clang \
      -DCMAKE_CXX_COMPILER=clang++ \
      -DOPUS_UPSTREAM_DIR=/src/upstream \
 && cmake --build /build --parallel "$(nproc)"

RUN mkdir -p /opt/fireblocks/bin /opt/fireblocks/lib /opt/fireblocks/data \
 && /build/harness/cmp_ecdsa_online/mk_snapshot \
      /opt/fireblocks/data/snapshot.bin 1 1 2 \
 && /build/harness/cmp_ecdsa_online/mk_snapshot \
      /opt/fireblocks/data/snapshot_tn.bin 1 --t 3 1 2 3 4 \
 && ASAN_OPTIONS=halt_on_error=1:abort_on_error=1:detect_leaks=1 \
      UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
      /build/harness/cmp_ecdsa_online/opus_selftest \
      /opt/fireblocks/data/snapshot.bin \
 && ASAN_OPTIONS=halt_on_error=1:abort_on_error=1:detect_leaks=1 \
      UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
      /build/harness/cmp_ecdsa_online/opus_selftest \
      /opt/fireblocks/data/snapshot_tn.bin \
 && ASAN_OPTIONS=halt_on_error=1:abort_on_error=1:detect_leaks=1 \
      UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
      /build/harness/cmp_ecdsa_online/opus_test_extra_map_key \
 && ASAN_OPTIONS=halt_on_error=1:abort_on_error=1:detect_leaks=1 \
      UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
      /build/harness/cmp_ecdsa_online/opus_cmp_smoke \
      /opt/fireblocks/data/snapshot.bin \
 && cp /build/opus_cmp_fuzzer /opt/fireblocks/bin/ \
 && cp /build/harness/cmp_ecdsa_online/opus_cmp_fuzzer_reachability_v2 \
      /opt/fireblocks/bin/ \
 && COSIGNER="$(find /build -name 'libcosigner.so' -type f -print -quit)" \
 && test -n "$COSIGNER" \
 && cp "$COSIGNER" /opt/fireblocks/lib/libcosigner.so \
 && ldd /opt/fireblocks/bin/opus_cmp_fuzzer > /tmp/opus_cmp_fuzzer.ldd \
 && ! grep -q 'not found' /tmp/opus_cmp_fuzzer.ldd \
 && ldd /opt/fireblocks/bin/opus_cmp_fuzzer_reachability_v2 > /tmp/rt4.ldd \
 && ! grep -q 'not found' /tmp/rt4.ldd \
 && rm -f /tmp/opus_cmp_fuzzer.ldd /tmp/rt4.ldd

FROM ubuntu:20.04@sha256:c664f8f86ed5a386b0a340d981b8f81714e21a8b9c73f658c4bea56aa179d54a

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgcc-s1 libssl1.1 libstdc++6 libuuid1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/fireblocks /opt/fireblocks
COPY docker/lane-entrypoint.sh /opt/fireblocks/bin/lane-entrypoint.sh

ENV FIREBLOCKS_SNAPSHOT=/opt/fireblocks/data/snapshot.bin
ENV LD_LIBRARY_PATH=/opt/fireblocks/lib

LABEL org.opencontainers.image.source="https://github.com/creador777/fireblocks-mpc-hunt"
LABEL org.opencontainers.image.description="Deterministic CMP ECDSA fuzzing harness"

# El dispatcher elige binario y snapshot segun FIREBLOCKS_LANE. Sin esa
# variable la lane es cmp_general, que es el binario y el snapshot de hoy.
ENTRYPOINT ["/bin/sh", "/opt/fireblocks/bin/lane-entrypoint.sh"]
